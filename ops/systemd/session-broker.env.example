# EnvironmentFile del session broker (user) — PLANTILLA SIN VALORES SECRETOS.
#
# Copia este archivo a tu configuración de usuario, ajusta las rutas y
# protégelo ANTES de definir cualquier secreto:
#   chmod 600 ~/.config/session-broker/broker.env
#
# Los secretos (credencial de grant, MAC key del root binding) viven SOLO en
# este archivo con permisos 600. Jamás los pongas en ExecStart, en la línea de
# comandos, en la unidad systemd ni en archivos versionados.
SESSION_BROKER_DATA_DIR=/ABSOLUTE/PATH/.local/share/session-broker
SESSION_BROKER_HOST=127.0.0.1
SESSION_BROKER_PORT=8791
# SESSION_BROKER_MAC_KEY=  (define aquí la MAC key del root binding; 600)
